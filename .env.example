BOT_TOKEN=
# Optional; resolved automatically from BOT_TOKEN when omitted.
BOT_USERNAME=
WEBAPP_URL=https://skinsavo-web-production.up.railway.app
ADMIN_TELEGRAM_ID=
# Optional. Enables /admin and /reply for this Telegram user only.
# Webhook secret is derived from BOT_TOKEN by default; no extra variable is needed.
# TELEGRAM_WEBHOOK_SECRET must contain only A-Z, a-z, 0-9, underscore and hyphen.
# TELEGRAM_WEBHOOK_SECRET=
# Railway: set this to the database path in your EXISTING persistent volume.
# Do not change an existing deployment path without migrating its database.
# DATABASE_PATH=/data/skinsavo.db
# Stage 1: keep sqlite while deploying the compatibility version.
DATABASE_BACKEND=sqlite
# Server-only Supabase Session pooler URI. Percent-encode special password characters.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Stage 2: after the compatibility deployment is healthy, set DATABASE_BACKEND=postgres.
# The startup migrates and verifies the EXISTING DATABASE_PATH, retaining a frozen backup.
